{
  "name": "catalog",
  "version": "1.0.0",
  "description": "Catalog component of Nation Data Catalog.",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env ./server/server.ts",
    "dev": "nodemon --env-file-if-exists=.env ./server/server.ts",
