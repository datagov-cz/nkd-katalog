    "fastify": "^5.12.5",
    "jsonld": "^9.0.0",
    "n3": "^2.7.12",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pino": "^7.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.8",
    "vitest": "^5.0.1"
  }
