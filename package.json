{
  "name": "catalog",
  "version": "1.0.0",
  "description": "Catalog component of Nation Data Catalog.",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env ./server/server.ts",
    "dev": "nodemon --env-file-if-exists=.env ./server/server.ts",
    "test": "tsc && node --import tsx --test",
    "lint": "eslint .",
    "type-check": "npx tsc --checkJs",
    "golden:capture": "tsx --env-file-if-exists=.env tools/golden/capture.ts",
    "golden:render": "tsx tools/golden/render.ts",
    "golden:check": "tsx tools/golden/check.ts"
  },
  "author": "Digitální a informační agentura",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
